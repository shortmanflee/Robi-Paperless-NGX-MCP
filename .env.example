# --- Paperless-NGX connection ----------------------------------------------------
# Base URL of Paperless (without /api). Inside compose, use the service name.
PAPERLESS_URL=http://paperless:8000

# Option A (recommended): API token. In Paperless: profile menu -> My Profile -> API Auth Token
PAPERLESS_TOKEN=
# Option B: a user's credentials (HTTP Basic auth)
#PAPERLESS_USERNAME=mcp
#PAPERLESS_PASSWORD=change-me

# Paperless URL as users open it in a browser; used for share links (default: PAPERLESS_URL)
#PAPERLESS_PUBLIC_URL=https://paperless.lan
#PAPERLESS_VERIFY_SSL=true
#PAPERLESS_TIMEOUT=30
#PAPERLESS_UPLOAD_TIMEOUT=600   # large uploads/downloads to and from Paperless
#PAPERLESS_API_VERSION=10       # Paperless-NGX 3.x; use 9 for 2.x

# --- MCP server -------------------------------------------------------------------
# Bearer token(s) clients must send. Comma-separate to allow several / rotate.
# Generate with:  openssl rand -hex 32
MCP_AUTH_TOKENS=

# The URL clients use to reach THIS server. Upload/download links are built from it,
# so it must be reachable from where curl runs (e.g. https://paperless-mcp.lan).
#MCP_PUBLIC_URL=http://192.168.1.20:8000

#MCP_TRANSPORT=http          # or stdio for local single-user use
#MCP_PORT=8000
#MCP_PATH=/mcp
#MCP_READ_ONLY=false         # true = only search/get/list/report tools are exposed

# --- Files ------------------------------------------------------------------------
#MCP_MAX_UPLOAD_MB=100       # upload links and URL downloads
#MCP_MAX_INLINE_MB=10        # base64 uploads and download_document
#MCP_UPLOAD_SLOT_TTL=900     # seconds an upload/download link stays valid
#MCP_MAX_CONCURRENT_UPLOADS=2
#MCP_UPLOAD_DIR=/tmp/paperless-mcp
#MCP_ALLOW_URL_FETCH=true    # upload_document_from_url (public HTTPS only)
#MCP_URL_FETCH_TIMEOUT=300
# stdio only: folders upload_document_from_path may read (comma-separated)
#MCP_LOCAL_UPLOAD_ROOTS=~/Documents,~/Downloads

# Server-side tool search for clients WITHOUT native tool search: off | bm25 | regex.
#MCP_TOOL_SEARCH=off
#MCP_TOOL_SEARCH_MAX_RESULTS=5
# Optional Host-header allowlist (DNS-rebinding protection):
#MCP_ALLOWED_HOSTS=paperless-mcp.lan,192.168.1.20:8000
#LOG_LEVEL=INFO

# --- Dev stack only (docker-compose.dev.yml) --------------------------------------
#DEV_ADMIN_USER=admin
#DEV_ADMIN_PASSWORD=

# Secrets can also be read from files (Docker secrets):
#   PAPERLESS_TOKEN_FILE, PAPERLESS_PASSWORD_FILE, MCP_AUTH_TOKENS_FILE
